# Only exclude what we don't need in the build
node_modules
.git
.gitignore
.dockerignore
docker-compose.yaml
.env
.env.local
.vscode
.idea
.DS_Store
Thumbs.db
logs
*.log
coverage
*.lcov
*.tgz

# Exclude build outputs (will be generated during build)
frontend/dist
backend/dist
dist
build

# Exclude documentation we don't need in container
README.md
ARCHITECTURE.md
PROJECT-SUMMARY.md
QUICKSTART.md
FIXES-APPLIED.md
USER-PERMISSIONS.md
LICENSE

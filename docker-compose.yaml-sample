services:
  theme-studio:
    build:
      context: .
      args:
        # Optional: Specify custom user/group ID
        # Default is 1000:1000
        # USER_ID: 1000
        # GROUP_ID: 1000
    container_name: ha-theme-studio
    # Optional: Override user at runtime (format: "uid:gid")
    # user: "1000:1000"
    ports:
      - "3000:3000"
      - "3001:3001"
    volumes:
      # Framework source (persistent)
      - ./framework:/framework
      # Generated themes output (persistent)
      - ./output:/output
      # Optional: Direct integration with Home Assistant
      # - ./ha/config/themes:/output
    environment:
      - NODE_ENV=production
      - PORT=3001
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3001/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # Example: Home Assistant integration
  # Uncomment to run HA Theme Studio alongside Home Assistant
  # homeassistant:
  #   image: ghcr.io/home-assistant/home-assistant:stable
  #   container_name: homeassistant
  #   volumes:
  #     - ./ha/config:/config
  #     # Shared themes directory
  #     - ./output:/config/themes
  #   ports:
  #     - "8123:8123"
  #   restart: unless-stopped

volumes:
  framework:
  output:
